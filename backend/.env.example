# development | production
ENVIRONMENT=development

# Required in production: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# SQLite for local dev; use Postgres in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/pakka
DATABASE_URL=sqlite:///./pakka_fantasy.db

# Comma-separated browser origins allowed to call the API (only needed when the frontend is on another domain).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin account created on first start if no admin exists. In production ADMIN_PASSWORD must be set (12+ chars).
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=
ADMIN_NAME=League Admin

# Create a sample match and 22 players (development only).
SEED_DEMO_DATA=true

# Login/register attempts allowed per IP per window.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

LOG_LEVEL=INFO
